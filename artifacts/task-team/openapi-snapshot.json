{"openapi":"3.0.1","info":{"title":"GLOBBER","description":"GLOBBER API 명세서입니다.","version":"1.0"},"servers":[{"url":"https://globber.world/api","description":"운영 서버"},{"url":"https://dev.globber.world/api","description":"개발 서버"},{"url":"http://localhost:8080","description":"로컬 서버"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"도시 API","description":"도시 검색 및 인기 여행지 조회 API"},{"name":"여행기록 API","description":"여행기록 생성, 수정, 삭제, 조회 API"},{"name":"인증 API","description":"로그인, 로그아웃, 토큰 재발급 등 인증 관련 API"},{"name":"여행 인사이트 API","description":"멤버의 여행 데이터 기반 AI 인사이트 조회 API"},{"name":"멤버 여행 기록 API","description":"멤버의 여행 기록 생성, 조회, 삭제 API"},{"name":"S3 API","description":"S3 관련 API"},{"name":"테스트 API","description":"[개발용] 테스트 계정 로그인 API"},{"name":"이모지 API","description":"여행 기록의 이모지 등록 및 반응(리액션) 관련 API"},{"name":"지구본 API","description":"사용자의 여행 기록 지구본 조회 API"},{"name":"프로필 API","description":"사용자 프로필 조회 및 수정 API"},{"name":"북마크 API","description":"타인의 북마크 지구본 API"}],"paths":{"/api/v1/diaries/{diary_id}":{"get":{"tags":["여행기록 API"],"summary":"여행기록 상세 조회","description":"특정 여행기록의 상세 정보를 조회합니다. 로그인한 경우 Authorization을 보내면 이모지의 pressedByMe에 내가 눌렀는지가 표시됩니다(비로그인이면 false).","operationId":"getDiaryDetail","parameters":[{"name":"diary_id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"Authorization","in":"header","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseDiaryResponse"}}}}}},"put":{"tags":["여행기록 API"],"summary":"여행기록 수정","description":"본문과 최종 사진 목록(최대 3장)을 한 번에 반영합니다. photoId가 있는 사진은 유지하고 메타데이터를 수정하며, photoId가 없는 사진은 새로 추가합니다. 목록에 없는 기존 사진은 삭제됩니다. photos 배열 순서가 사진 표시 순서입니다. 다른 기록의 photoId가 포함되면 404를 반환하고 아무것도 변경하지 않습니다. 새 사진끼리 또는 유지하는 사진과 photoCode가 같으면 400, 다른 기록이 쓰는 photoCode면 409입니다. 요청의 cityId는 무시하며, 수정으로 기록의 도시는 바뀌지 않습니다.","operationId":"updateDiary","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}},{"name":"diary_id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiaryRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseDiaryResponse"}}}}}},"delete":{"tags":["여행기록 API"],"summary":"여행기록 삭제","description":"기존 여행기록을 삭제합니다.","operationId":"deleteDiary","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}},{"name":"diary_id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseVoid"}}}}}}},"/api/v1/cities/{cityId}":{"put":{"tags":["도시 API"],"summary":"도시 수정","description":"기존 도시 정보를 수정합니다.","operationId":"updateCity","parameters":[{"name":"cityId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"Authorization","in":"header","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CityRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseCityResponse"}}}}}},"delete":{"tags":["도시 API"],"summary":"도시 삭제","description":"기존 도시를 삭제합니다.","operationId":"deleteCity","parameters":[{"name":"cityId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"Authorization","in":"header","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseCityResponse"}}}}}}},"/reissue":{"post":{"tags":["인증 API"],"summary":"AccessToken 재발급","description":"AccessToken을 재발급합니다.","operationId":"reissue","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}},{"name":"RefreshToken","in":"cookie","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseObject"}}}}}}},"/logout":{"post":{"tags":["인증 API"],"summary":"로그아웃","description":"로그아웃을 진행합니다.","operationId":"logout","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseString"}}}}}}},"/dev/test-login":{"post":{"tags":["테스트 API"],"summary":"[개발용] 테스트 계정 로그인","description":"[dev/local 환경만] 설정된 테스트 계정으로 바로 로그인하여 JWT 토큰을 발급받습니다.","operationId":"testLogin","parameters":[{"name":"email","in":"query","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseJwtTokenResponse"}}}}}}},"/auth/token":{"post":{"tags":["인증 API"],"summary":"로그인 결과 받기","description":"로그인 성공 리다이렉트로 받은 일회용 code를 교환해 accessToken(\"Bearer \" 접두어 포함), memberId, uuid, firstLogin을 받습니다. code는 60초 동안 한 번만 쓸 수 있고, 잘못되었거나 만료되었거나 이미 쓴 code면 401입니다.","operationId":"exchangeLoginCode","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginCodeRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseLoginResult"}}}}}}},"/api/v1/s3/upload-url":{"post":{"tags":["S3 API"],"summary":"파일 업로드 Presigned URL 발급","description":"S3에 이미지를 업로드하기 위한 Presigned URL을 발급합니다. prefix에 업로드할 경로를 지정하세요. contentType은 image/jpeg, image/png, image/webp, image/avif만 허용합니다(그 외 400). PUT 업로드 시 응답의 uploadHeaders를 그대로 요청 헤더로 보내야 합니다. 업로드한 이미지는 10MB 이하여야 하며, 기록·프로필에 연결할 때 검사합니다.","operationId":"getUploadUrl","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PresignedUrlRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponsePresignedUrlResponse"}}}}}}},"/api/v1/member-travels":{"get":{"tags":["멤버 여행 기록 API"],"summary":"멤버 여행 기록 조회","description":"특정 멤버의 여행 기록을 조회합니다.","operationId":"getMemberTravelRecords","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMemberTravelAllResponse"}}}}}},"post":{"tags":["멤버 여행 기록 API"],"summary":"멤버 여행 기록 생성","description":"특정 멤버의 여행 기록을 생성합니다.","operationId":"createMemberTravel","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CreateMemberTravelRequest"}}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseMemberTravelAllResponse"}}}}}}},"/api/v1/diaries":{"get":{"tags":["여행기록 API"],"summary":"여행기록들 UUID로 조회","description":"특정 UUID의 여행기록을 모두 조회합니다. 로그인한 경우 Authorization을 보내면 이모지의 pressedByMe에 내가 눌렀는지가 표시됩니다(비로그인이면 false).","operationId":"getDiariesByUUID","parameters":[{"name":"uuid","in":"query","required":true,"schema":{"type":"string"}},{"name":"Authorization","in":"header","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseDiaryListResponse"}}}}}},"post":{"tags":["여행기록 API"],"summary":"여행기록 생성","description":"새로운 여행기록을 생성합니다. 사진은 최대 3장이며, photos 배열 순서(0부터)가 사진 표시 순서로 저장됩니다.","operationId":"createDiary","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiaryRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseDiaryResponse"}}}}}}},"/api/v1/diaries/{diaryId}/emojis/register":{"post":{"tags":["이모지 API"],"summary":"이모지 등록","description":"기록에 이모지를 등록하고, 등록한 사람이 누른 것으로 처리합니다(count 1). 이미 있는 code면 오류 없이 누른 상태가 되고, 이미 눌렀으면 변화가 없습니다. glyph는 code로 서버가 만듭니다. 로그인이 필요합니다.","operationId":"registerEmoji","parameters":[{"name":"diaryId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EmojiRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseEmojiResponse"}}}}}}},"/api/v1/diaries/{diaryId}/emojis/press":{"post":{"tags":["이모지 API"],"summary":"이모지 누르기(토글)","description":"누르지 않은 이모지면 count를 1 올리고, 이미 누른 이모지면 취소하고 1 내립니다. 한 사람은 이모지마다 한 번만 반응할 수 있습니다. 로그인이 필요합니다.","operationId":"pressEmoji","parameters":[{"name":"diaryId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EmojiRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseEmojiResponse"}}}}}}},"/api/v1/cities":{"get":{"tags":["도시 API"],"summary":"도시 검색","description":"키워드 기반으로 도시/국가를 검색합니다. 유사도 + 인기순으로 정렬하며 최대 20개를 반환합니다.\n검색어는 앞뒤 공백을 제거해 사용하고, 비어 있거나 누락되면 400을 반환합니다.\n응답은 ApiResponse로 감싸며 data에 cities를 담습니다.","operationId":"search","parameters":[{"name":"keyword","in":"query","description":"검색어(앞뒤 공백 제거 후 1자 이상)","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseSearchResult"}}}}}},"post":{"tags":["도시 API"],"summary":"도시 추가","description":"새로운 도시를 추가합니다.","operationId":"addCity","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CityRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseCityResponse"}}}}}}},"/api/v1/bookmarks":{"get":{"tags":["북마크 API"],"summary":"북마크 목록 조회","description":"내가 북마크한 사용자 목록을 조회합니다.","operationId":"getBookmarks","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}},{"name":"sort","in":"query","required":false,"schema":{"type":"string","default":"LATEST","enum":["latest","name"]}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseListBookmarkedFriendResponse"}}}}}},"post":{"tags":["북마크 API"],"summary":"북마크 추가","description":"특정 사용자를 북마크에 추가합니다. 로그인이 필요하며, 비로그인 요청은 401을 반환합니다.","operationId":"addBookmark","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookmarkRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseVoid"}}}}}}},"/api/v1/profiles/me":{"get":{"tags":["프로필 API"],"summary":"내 프로필 조회","description":"현재 로그인한 사용자의 프로필 정보를 조회합니다.","operationId":"getMyProfile","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseProfileResponse"}}}}}},"patch":{"tags":["프로필 API"],"summary":"내 프로필 수정","description":"현재 로그인 사용자의 정보(닉네임)를 수정합니다.","operationId":"updateProfile","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateProfileRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseProfileResponse"}}}}}}},"/api/v1/profiles/me/image":{"patch":{"tags":["프로필 API"],"summary":"프로필 이미지 수정","description":"현재 로그인한 사용자의 프로필 이미지를 수정합니다.(프론트에서 S3에 업로드 후 S3 key를 전달)","operationId":"updateProfileImage","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateProfileImageRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseProfileResponse"}}}}}}},"/api/v1/travel-insights/{memberId}":{"get":{"tags":["여행 인사이트 API"],"summary":"멤버 여행 AI 인사이트 조회","description":"특정 멤버의 여행 데이터 기반 AI 인사이트를 조회합니다.","operationId":"getMemberTravelInsight","parameters":[{"name":"memberId","in":"path","required":true,"schema":{"type":"integer","format":"int64"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseTravelInsightResponse"}}}}}}},"/api/v1/member-travels/listViews":{"get":{"tags":["멤버 여행 기록 API"],"summary":"멤버 리스트 뷰 조회","description":"특정 멤버의 리스트 뷰를 조회합니다.","operationId":"getMemberListView","parameters":[{"name":"Authorization","in":"header","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseTravelRecordWithDiaryResponse"}}}}}}},"/api/v1/globes/{uuid}":{"get":{"tags":["지구본 API"],"summary":"지구본 조회 API","description":"사용자의 UUID를 기반으로 해당 사용자의 여행 기록(지구본 요약)을 조회합니다. UUID는 소셜 로그인 성공 시 서버에서 발급되어 프론트엔드로 전달됩니다.","operationId":"getGlobe","parameters":[{"name":"uuid","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ApiResponseGlobeSummaryDto"
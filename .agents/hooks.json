{
  "harness-guards": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" session-start sync"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" pre-tool-bash block-attribution-trailers"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" pre-tool-bash enforce-commit-msg-style"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" pre-tool-bash git-safety-guard"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" pre-tool-bash block-lint-warnings-on-commit"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" pre-tool-bash block-manual-merge-repo"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" pre-tool-bash require-source-before-best-practice-edit"
          }
        ]
      },
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" pre-tool-edit block-em-dash-in-source"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" pre-tool-edit block-comment-line-wrap"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" pre-tool-edit require-coderabbit-run"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" pre-tool-edit require-source-before-best-practice-edit"
          }
        ]
      },
      {
        "matcher": "run_command|edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" pre-tool-edit require-harness-lab-before-harness-edit"
          }
        ]
      },
      {
        "matcher": "swarm",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" pre-tool-swarm verify-swarm-role"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" post-tool-edit auto-format",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" stop require-korean-response"
      },
      {
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" stop block-unverified-claims"
      },
      {
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-hook-adapter.mjs\" stop require-execution-for-declared-step"
      }
    ]
  }
}

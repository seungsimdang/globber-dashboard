# 단일 관리자 계정 로그인 정보
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 세션 쿠키 서명 키 (임의의 긴 랜덤 문자열로 설정)
AUTH_SECRET=change-me-to-a-long-random-string

# 도시 API 상류 서버 주소 (서버 전용, 끝 슬래시 없음)
CITY_API_BASE_URL=http://127.0.0.1:8080

# 도시 쓰기(추가/수정/삭제) 토큰 발급에 쓸 테스트 계정 이메일 (서버 전용)
CITY_API_TEST_EMAIL=test@example.com

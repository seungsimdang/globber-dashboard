# 단일 관리자 계정 로그인 정보
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# 세션 쿠키 서명 키 (임의의 긴 랜덤 문자열로 설정)
AUTH_SECRET=change-me-to-a-long-random-string

# 운영 도시 API 기준 주소 (서버 전용, 끝 슬래시 없음, 조회 전용)
CITY_API_PROD_BASE_URL=https://prod.example.com/api

# 개발 도시 API 기준 주소 (서버 전용, 끝 슬래시 없음, 조회·쓰기·토큰 발급)
CITY_API_DEV_BASE_URL=http://127.0.0.1:8080

# 개발 서버 쓰기(추가/수정/삭제) 토큰 발급에 쓸 테스트 계정 이메일 (서버 전용)
CITY_API_TEST_EMAIL=test@example.com

# 위치 검색(Nominatim) 요청의 User-Agent (서버 전용, 선택). 비우면 앱 기본 식별자를 쓴다
NOMINATIM_USER_AGENT=

# true이면 위치 검색을 호출 없이 비활성(서버 전용, 선택). 이용 정책상 중단 요청 대응용
NOMINATIM_DISABLED=
